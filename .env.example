# Run npm run init to create private configuration.
# New installations use standalone. Omitted PAPER_BACKEND retains legacy FreshRSS mode.
PAPER_BACKEND=standalone
PUBLIC_URL=http://localhost:8080
FRESHRSS_BASE_URL=
FRESHRSS_USERNAME=
FRESHRSS_API_PASSWORD=
PAPER_INTERNAL_SECRET=replace-me
PAPER_SIGNING_SECRET=replace-me
TZ=UTC

# Standalone reads locally immediately; FreshRSS activates local reads after import.
PAPER_SYNC_ENABLED=true
PAPER_LOCAL_READS=true
PAPER_SYNC_MINUTES=28,58

# Private feed proxies are opt-in. Use comma-separated origins without paths.
PAPER_TRUSTED_FEED_ORIGINS=
RSSHUB_BASE_URL=
# Sends blocked article URLs to r.jina.ai when explicitly enabled.
PAPER_READER_FALLBACK_ENABLED=false

# Optional connection defaults. Settings > Reading & connections can override these.
# Tokens and switches saved in Settings persist in data/connections.json.
READWISE_TOKEN=
READWISE_LOCATION=later
KIRBY_PUBLISH_URL=
KIRBY_PUBLISH_TOKEN=

# AI is disabled by default. See docs/integrations.md before enabling it.
CODEX_ENABLED=false
CODEX_BIN=/usr/local/bin/codex
CODEX_SHORTLIST_MODEL=gpt-5.6-luna
CODEX_EDITOR_MODEL=gpt-5.6-sol
PAPER_DISCUSSION_MODEL=gpt-5.6-sol
OPENCODE_ENABLED=false
OPENCODE_BIN=/usr/local/bin/opencode
OPENCODE_SHORTLIST_MODEL=openai/gpt-5.6-luna-fast
OPENCODE_EDITOR_MODEL=openai/gpt-5.6-terra
PAPER_COLLECTIONS_ENABLED=true
PAPER_COLLECTION_MODEL=gpt-5.6-luna
PAPER_CLEAR_HEADLINES=true
PAPER_HEADLINE_WRITER_MODEL=gpt-5.6-terra
PAPER_HEADLINE_REVIEWER_MODEL=gpt-5.6-sol
PAPER_BRIEFING_INCLUDE_READ_UNTIL=
