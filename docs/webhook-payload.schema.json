{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper webhook",
  "type": "object",
  "required": ["event_type", "delivery_id"],
  "properties": {
    "delivery_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "event_type": { "enum": ["new_entries", "starred_entry", "save_entry", "test"] }
  },
  "oneOf": [
    {
      "properties": {
        "event_type": { "const": "new_entries" },
        "entries": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/article" } }
      },
      "required": ["entries"]
    },
    {
      "properties": {
        "event_type": { "enum": ["starred_entry", "save_entry"] },
        "entry": { "$ref": "#/$defs/article" }
      },
      "required": ["entry"]
    },
    { "properties": { "event_type": { "const": "test" } } }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "article": {
      "type": "object",
      "required": ["id", "feed_id", "title", "url"],
      "properties": {
        "id": { "type": "string", "maxLength": 512 },
        "feed_id": { "type": "string", "maxLength": 512 },
        "title": { "type": "string", "maxLength": 512 },
        "url": { "type": "string", "maxLength": 2048 }
      },
      "additionalProperties": false
    }
  }
}
