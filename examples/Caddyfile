# Optional reader apps: enable Paper app authentication first, then add
# @browser not path /api/greader.php /api/greader.php/*
# inside this site and change basic_auth to basic_auth @browser.
# Keep Host, Authorization and the no-store header unchanged.
{$PAPER_DOMAIN} {
    basic_auth {
        {$PAPER_AUTH_USER} {$PAPER_AUTH_PASSWORD_HASH}
    }
    header {
        Cache-Control "private, no-store"
        X-Content-Type-Options "nosniff"
        ?Content-Security-Policy "frame-ancestors 'none'"
        ?X-Frame-Options "DENY"
        X-Robots-Tag "noindex, noarchive"
    }
    reverse_proxy paper:8080
}
